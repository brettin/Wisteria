# Wisteria Web Backend - Production Environment Variables
# Source this file before running gunicorn: source production.env

# Flask Configuration
export SECRET_KEY="change-this-to-a-secure-random-key-in-production"
export FLASK_ENV="production"

# Database Configuration
# For SQLite (default):
export DATABASE_URL="sqlite:///wisteria.db"
# For PostgreSQL (recommended for production):
# export DATABASE_URL="postgresql://username:password@localhost/wisteria_db"
# For MySQL:
# export DATABASE_URL="mysql://username:password@localhost/wisteria_db"

# CORS Configuration (add your production domains)
export CORS_ORIGINS="http://localhost:12001,http://127.0.0.1:12001"

# API Keys (uncomment and set as needed)
# export OPENAI_API_KEY="your_openai_api_key_here"
# export ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Server Configuration
export HOST="0.0.0.0"
export PORT="12005"

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
export LOG_LEVEL="INFO"

# Additional production settings
export SQLALCHEMY_TRACK_MODIFICATIONS="False" 